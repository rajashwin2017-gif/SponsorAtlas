// SponsorAtlas — Prisma schema
// MySQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Sponsor {
  id               String   @id @default(uuid())
  organisationName String
  normalisedName   String // UPPER() normalised for fuzzy matching
  town             String
  townNormalised   String // canonical city (title-cased, deduped)
  county           String   @default("")
  rating           String // "A", "B", "Provisional"
  ratingType       String   @default("Worker") // "Worker", "Temporary Worker"
  licenceStatus    String   @default("Active")
  addedDate        DateTime @default(now())
  lastUpdated      DateTime @updatedAt

  // Enriched classification
  industryCategory     String @default("Other")
  companySize          String @default("SME") // "Startup", "SME", "Enterprise"
  sicCode              String @default("")
  companiesHouseNumber String @default("")

  // Sponsor intelligence scores (0–100, computed at import)
  sponsorStrengthScore Int @default(0)
  opportunityScore     Int @default(0)

  // Tier classification
  sponsorTier    String @default("Inactive") // Platinum/Gold/Silver/Bronze/Active/Inactive
  hiringActivity String @default("Inactive") // VeryHigh/High/Medium/Low/Inactive

  // 2025 CoS data from FOI
  cos2025Sw            Int? // Skilled Worker CoS used
  cos2025Gbm           Int? // GBM CoS used
  cos2025SwSuppressed  Boolean @default(false) // true = 1–4 CoS (suppressed by Home Office)
  cos2025GbmSuppressed Boolean @default(false)
  cos2025Total         Int? // sw + gbm combined

  // Legacy / live signals
  liveJobsCount     Int       @default(0)
  lastJobPostedAt   DateTime?
  suggestedSocCodes Json      @default("[]") // MySQL has no native scalar array type — stored as a JSON array of SOC codes

  // Relationships
  routes SponsorRoute[]
  alerts OpportunityAlert[]
  jobs   Job[]

  @@index([normalisedName])
  @@index([townNormalised])
  @@index([sponsorTier])
  @@index([hiringActivity])
  @@index([industryCategory])
  @@index([sponsorStrengthScore])
  @@index([opportunityScore])
  @@index([cos2025Total])
  @@map("sponsors")
}

model SponsorRoute {
  id        String  @id @default(uuid())
  sponsorId String
  route     String // "Skilled Worker", "Global Business Mobility: Senior or Specialist Worker", etc.
  sponsor   Sponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@unique([sponsorId, route])
  @@index([route])
  @@map("sponsor_routes")
}

model CityStats {
  id            String @id @default(uuid())
  cityName      String @unique
  normalised    String @unique // lowercase
  totalSponsors Int    @default(0)
  cos2025Total  Int    @default(0)
  topIndustry   String @default("")
  topRoute      String @default("")

  @@map("city_stats")
}

model Job {
  id            String   @id @default(uuid())
  sponsorId     String
  title         String
  location      String?
  salaryMin     Decimal? @db.Decimal(10, 2)
  salaryMax     Decimal? @db.Decimal(10, 2)
  jobType       String?  @default("Full-time")
  visaSponsored Boolean  @default(true)
  source        String   @default("direct")
  sourceUrl     String?
  socCode       String?
  description   String?
  postedAt      DateTime @default(now())
  isActive      Boolean  @default(true)

  sponsor Sponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@index([sponsorId])
  @@index([postedAt])
  @@map("jobs")
}

model CommunityPost {
  id         String   @id @default(uuid())
  authorName String
  category   String   @default("question")
  title      String
  content    String
  tags       Json     @default("[]") // MySQL has no native scalar array type — stored as a JSON array of tags
  upvotes    Int      @default(0)
  replies    Int      @default(0)
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("community_posts")
}

model SocCode {
  id              String  @id @default(uuid())
  socCode         String  @unique // e.g., "2135"
  occupationTitle String
  skillLevel      String // "RQF 3", "RQF 6", etc.
  goingRate2026   Decimal @db.Decimal(10, 2)
  lowerRate2026   Decimal @db.Decimal(10, 2)
  isOnIsl         Boolean @default(false) // Immigration Salary List
  isOnTsl         Boolean @default(false) // Temporary Salary List
  description     String?

  @@map("soc_codes")
}

enum Role {
  MEMBER
  ADMIN
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  name                 String?
  image                String?
  password             String? // bcrypt hash; null for OAuth-only accounts
  role                 Role      @default(MEMBER)
  status               String    @default("active") // "active", "suspended"
  emailVerified        DateTime?
  subscriptionTier     String    @default("free") // "free", "pro", "pro_plus"
  subscriptionStatus   String    @default("inactive")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  monthlyChecksUsed    Int       @default(0)
  monthlyChecksLimit   Int       @default(5)
  alertFrequency       String    @default("weekly") // "daily", "weekly", "none"
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  savedSponsors       SavedSponsor[]
  alerts              OpportunityAlert[]
  fitChecks           FitCheck[]
  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  subscriptions       Subscription[]
  payments            Payment[]
  invoices            Invoice[]
  auditLogs           AuditLog[]           @relation("AuditLogActor")

  @@index([role])
  @@index([stripeCustomerId])
  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Plan {
  id     String @id @default(uuid())
  planId String @unique // stable slug referenced by checkout/webhook, e.g. "pro"

  name         String
  tagline      String?
  badge        String?
  highlighted  Boolean @default(false)
  active       Boolean @default(true) // soft-hide from public pricing page; never hard-delete (subscribers may reference it)
  displayOrder Int     @default(0)

  monthlyPriceMinor Int // pence
  yearlyPriceMinor  Int // pence
  features          Json // string[]

  // Null until the plan has been saved at least once with Stripe configured.
  stripeProductId      String?
  stripeMonthlyPriceId String? @unique
  stripeYearlyPriceId  String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}

model Subscription {
  id                   String    @id @default(uuid())
  userId               String
  stripeSubscriptionId String    @unique
  stripePriceId        String
  plan                 String // "pro", "pro_plus"
  interval             String // "month", "year"
  status               String // "active", "trialing", "past_due", "canceled", "unpaid", "incomplete"
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model Payment {
  id                    String   @id @default(uuid())
  userId                String
  stripePaymentIntentId String?  @unique
  stripeInvoiceId       String?
  amount                Int // in minor units (pence/cents)
  currency              String   @default("gbp")
  status                String // "succeeded", "failed", "refunded", "pending"
  createdAt             DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

model Invoice {
  id               String   @id @default(uuid())
  userId           String
  stripeInvoiceId  String   @unique
  amount           Int // in minor units
  currency         String   @default("gbp")
  status           String // "paid", "open", "void", "uncollectible"
  hostedInvoiceUrl String?
  pdfUrl           String?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("invoices")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String // e.g. "user.suspend", "subscription.cancel"
  targetType String? // e.g. "User", "Subscription"
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

model SavedSponsor {
  id        String   @id @default(uuid())
  userId    String
  // No DB-level FK to Sponsor: the live site's sponsor IDs come from the
  // 126k+ real dataset (not yet imported into this table — see Phase 5 of
  // the static->dynamic migration). Revisit once that import lands.
  sponsorId String
  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sponsorId])
  @@index([sponsorId])
  @@map("saved_sponsors")
}

model OpportunityAlert {
  id        String    @id @default(uuid())
  userId    String
  sponsorId String?
  industry  String?
  city      String?
  frequency String    @default("weekly")
  lastSent  DateTime?
  isActive  Boolean   @default(true)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sponsor Sponsor? @relation(fields: [sponsorId], references: [id])

  @@map("opportunity_alerts")
}

model FitCheck {
  id             String   @id @default(uuid())
  userId         String
  sponsorId      String
  score          Int // 0-100
  suggestedRoles Json     @default("[]") // MySQL has no native scalar array type — stored as a JSON array of SOC codes
  salaryMatch    Boolean
  gapAnalysis    String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("fit_checks")
}

// ── NextAuth.js required models ─────────────────────────────────────────────

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
