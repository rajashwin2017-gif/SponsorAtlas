{
  "name": "sponsoratlas-server",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Express/Node.js backend for SponsorAtlas (auth, users, admin, Stripe billing). Plain SQL (MySQL), no ORM.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/runMigration.js",
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "resend": "^3.5.0",
    "stripe": "^22.2.2",
    "uuid": "^11.1.1",
    "zod": "^3.23.8"
  }
}
