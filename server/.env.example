# ─────────────────────────────────────────────────────────────
# SponsorAtlas standalone API server — environment variables
# Copy to `.env` and fill in.
# ─────────────────────────────────────────────────────────────

# Port this Express server listens on.
PORT=4000

# MySQL connection (plain mysql2 Pool, no ORM).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sponsoratlas
DB_POOL_LIMIT=10

# Secret used to sign/verify login JWTs. Generate with: openssl rand -base64 32
JWT_SECRET="generate-with: openssl rand -base64 32"

# URL of the frontend that will call this API (used for CORS + Stripe
# checkout/portal redirect URLs).
CLIENT_URL="http://localhost:3000"

# ── Stripe (subscription billing) ───────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_PRO_PLUS_MONTHLY=""
STRIPE_PRICE_PRO_PLUS_YEARLY=""

# ── Email (Resend — verification, password reset) ──────────────
RESEND_API_KEY=""
EMAIL_FROM="SponsorAtlas <noreply@sponsoratlas.app>"

NODE_ENV="development"
