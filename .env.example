# ─────────────────────────────────────────────────────────────
# SponsorAtlas environment variables
# Copy to `.env` and fill in. The app RUNS without any of these
# (it falls back to bundled mock data), but the integrations below
# activate the corresponding production features.
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL — Supabase / Railway / Neon) ──────────
# Full connection string used by Prisma for all reads/writes.
DATABASE_URL="postgresql://user:password@localhost:5432/sponsoratlas?schema=public"

# ── Auth (NextAuth.js / Auth.js) ────────────────────────────────
# Canonical URL of the app; NextAuth uses this to build callback/redirect URLs.
NEXTAUTH_URL="http://localhost:3000"
# Secret used to sign/encrypt session JWTs and CSRF tokens. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
# Optional Google OAuth sign-in. Leave blank to disable the Google button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Stripe (subscription billing) ───────────────────────────────
# Secret API key used server-side to create checkout sessions, manage
# customers/subscriptions, and query invoices/payments.
STRIPE_SECRET_KEY=""
# Signing secret for verifying incoming webhook requests came from Stripe
# (from `stripe listen` in dev, or the Stripe Dashboard webhook endpoint in prod).
STRIPE_WEBHOOK_SECRET=""
# Publishable key exposed to the browser for Stripe.js / redirect-to-checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Price IDs for each paid plan × billing interval, created in the Stripe Dashboard.
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_PRO_PLUS_MONTHLY=""
STRIPE_PRICE_PRO_PLUS_YEARLY=""

# ── Email (Resend — verification, password reset, invoices) ────
# API key for the Resend transactional email service.
RESEND_API_KEY=""
# "From" address used for verification/reset/billing emails.
EMAIL_FROM="SponsorAtlas <noreply@sponsoratlas.app>"
# "From" address used specifically for opportunity alert digests.
ALERT_FROM_EMAIL="alerts@sponsoratlas.app"

# ── OpenAI (AI Sponsorship Fit scoring) — optional ──────────────
# Falls back to a local heuristic scorer if unset.
OPENAI_API_KEY=""

# ── Adzuna (live job listings fallback for all 126K sponsors) ──
# Register free at https://developer.adzuna.com/
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# ── App URLs ─────────────────────────────────────────────────────
# Public base URL of the member-facing app (used in emails, redirects, CORS).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Public base URL of the admin dashboard. In dev this is a distinct subdomain
# on the same Next.js server (admin.localhost:3000); in prod point it at your
# real admin subdomain (admin.mydomain.com).
NEXT_PUBLIC_ADMIN_URL="http://admin.localhost:3000"

# ── Rate limiting ────────────────────────────────────────────────
# Optional Upstash Redis credentials for distributed rate limiting on auth
# routes. If unset, an in-memory limiter is used (fine for a single instance,
# not shared across serverless/edge replicas).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Misc ─────────────────────────────────────────────────────────
NODE_ENV="development"
